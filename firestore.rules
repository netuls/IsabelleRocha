rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() { return request.auth != null && request.auth.token.email == 'admin@welissonbarber.com'; }

    match /agendamentos/{id} {
      allow read: if true;
      allow create: if isAdmin() || (
           request.resource.data.keys().hasOnly(
             ['tipo','servico','preco','cliente','telefone','data','horario','obs','formaPagamento','status','criadoEm',
              'sinal','sinalPago','precoOriginal','fidelidade','aniversario'])
        && request.resource.data.status == 'agendado'
        && request.resource.data.cliente is string
        && request.resource.data.cliente.size() < 100
        && (!('sinalPago' in request.resource.data) || request.resource.data.sinalPago == false));
      // Cliente pode cancelar, ou remarcar (muda só data e horário; o status volta para "agendado" e o dono confirma de novo)
      allow update: if isAdmin() || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','canceladoEm'])
          && request.resource.data.status == 'cancelado'
        ) || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['data','horario','remarcadoEm','status'])
          && resource.data.status in ['agendado','confirmado']
          && request.resource.data.status == 'agendado');
      allow delete: if isAdmin();
    }

    // Fotos de antes e depois (o site lê; só o dono grava)
    match /antesdepois/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /clientes/{tel} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if isAdmin() || request.resource.data.keys().hasOnly(
          ['nome','telefone','nascimento','criadoEm']);
      allow update, delete: if isAdmin();
    }

    match /config/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /_config/{doc} {
      allow read, write: if isAdmin();
    }
  }
}
